# NEXUS frontend configuration — copy to .env.local and adjust.
# VITE_* values are compiled into the public bundle: never put secrets here.

# FastAPI base URL (no trailing slash). With the Vite dev proxy use `/api`
# (vite.config.ts forwards /api → http://localhost:8000). See MASTER_SPEC.md §7 for every route.
VITE_API_URL=/api

# Demo kill switch.
# true  = fully self-contained demo on local mock data (safe, no backend needed)
# false = live mode: sign-in, workspace, mutations and the assistant go to FastAPI
VITE_USE_MOCK=true
