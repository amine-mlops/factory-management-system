# NEXUS frontend configuration — copy to .env.local and adjust.
# VITE_* values are compiled into the public bundle: never put secrets here.

# FastAPI origin (no trailing slash). Endpoints used: GET /health, POST /triage/infer;
# see INTEGRATION.md for the full route mapping.
VITE_API_URL=http://localhost:8000

# Demo kill switch.
# true  = fully self-contained demo on local mock data (default, safe)
# false = call FastAPI; any error/timeout falls back to mock data with a visible notice
VITE_USE_MOCK=true
