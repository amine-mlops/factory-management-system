        "value": "Dairy"
      },
      {
        "field": "current_temp",
        "op": ">",
        "field_ref": "max_safe_temp"
      }
    ]
  },
  {
    "id": "RULE-EXP-01",
    "label": "Expiry — critical window",
    "severity": "CRITICAL",
