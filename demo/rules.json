[
  {
    "id": "RULE-COLD-01",
    "label": "Cold-Chain Dairy Compliance",
    "severity": "CRITICAL",
    "active": true,
    "source": "seed",
    "text": "Flag any dairy batch whose temperature exceeds its safe maximum",
    "table": "inventory",
    "conditions": [
