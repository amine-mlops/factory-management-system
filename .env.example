# --- LLM intent parser (agent observability) ---------------------------------
# Any one of these keys is picked up (in priority order).
LLM_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=

# OpenAI-compatible endpoint. Defaults to OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
# Plain OpenAI: https://api.openai.com/v1

LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT=30
