# NEXUS backend configuration — copy to .env (gitignored). Never commit real secrets.
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Startup fails if missing and DEMO_MODE=false (DEMO_MODE=true falls back to a fixed demo-only secret)
JWT_SECRET=change-me-in-.env
JWT_TTL_MINUTES=480
# Enables /api/auth/demo-login + seed-on-empty
DEMO_MODE=true
DB_PATH=demo/supply_chain.duckdb
DOCS_DIR=demo/docs
UPLOADS_DIR=demo/uploads
RULES_PATH=demo/rules.json
AUDIT_SCHEDULER=on
AUDIT_INTERVAL_SECONDS=300
# Any OpenAI-compatible endpoint (NVIDIA NIM). Empty key → deterministic mode (fully offline).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=12
# tfidf | chroma (chroma is optional and not installed by default)
RAG_BACKEND=tfidf
